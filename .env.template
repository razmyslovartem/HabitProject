# Django
# Сгенерировать командой: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Режим отладки: True для разработки, False для продакшена
DEBUG=*******

# Кодировка для Windows (не менять, обязательно!)
PYTHONIOENCODING=utf-8

# База данных PostgreSQL
DB_NAME=habitproject           # Имя базы данных
DB_USER=postgres               # Пользователь PostgreSQL
DB_PASSWORD=your-db-password   # Пароль PostgreSQL (обязательно изменить!)
DB_HOST=localhost              # Хост базы данных
DB_PORT=5432                   # Порт PostgreSQL (по умолчанию 5432)
DB_HOST_PORT=0000

# Telegram Bot
# Получить токен у @BotFather в Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Celery
CELERY_BROKER_URL=redis://**********:0000/0
CELERY_RESULT_BACKEND=redis://*********:0000/0
